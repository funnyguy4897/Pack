{
  "schemaVersion": 1,
  "id": "packmixer",
  "version": "${version}",
  "name": "Pack Mixer",
  "description": "Mix and match individual parts of resource packs: crystals, anchors, sky, stone and more. Press K to open.",
  "authors": [
    "Pack Mixer"
  ],
  "license": "MIT",
  "icon": "assets/packmixer/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.packmixer.PackMixerMod"
    ],
    "modmenu": [
      "dev.packmixer.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "~26.1",
    "java": ">=25",
    "fabric-api": "*"
  },
  "custom": {
    "modmenu": {
      "badges": [
        "client"
      ]
    }
  }
}